# Copy to .env and fill in. Any keys left blank → backend falls back to deterministic mocks.

# LLM (OpenAI). Used by claim extractor, synthesizer, critic.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Web search (Tavily). Used by web research agent.
TAVILY_API_KEY=

# Google Fact Check Tools Claim Search API.
GOOGLE_FACT_CHECK_API_KEY=

# Optional. If unset, reddit agent uses public .json endpoints via rotating UA.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=veritas/0.1

# CORS — comma-separated origins for the frontend.
ALLOWED_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=INFO
